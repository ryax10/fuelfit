# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only (NUNCA exponer en cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Para generar tipos TypeScript con `npm run db:types`
# Obtené el project-ref en: https://supabase.com/dashboard/project/<project-ref>/settings/general
SUPABASE_PROJECT_REF=your-project-ref-here

# Panel Admin
ADMIN_SECRET=una-cadena-aleatoria-larga-y-segura
ADMIN_1_USERNAME=usuario1
ADMIN_1_DISPLAY=Nombre-Visible-1
# Generá el hash con: node scripts/hash-admin-password.js "tu_contraseña"
ADMIN_1_PASSWORD=$2b$12$hash-generado-aqui
ADMIN_2_USERNAME=usuario2
ADMIN_2_DISPLAY=Nombre-Visible-2
ADMIN_2_PASSWORD=$2b$12$hash-generado-aqui
